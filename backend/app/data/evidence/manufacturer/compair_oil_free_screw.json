  "vendor_claims_not_for_calculation": [
    {"claim": "Every 1 bar above required pressure costs about 7 % extra power", "sources": ["SRC-D3775", "SRC-DX90160", "SRC-DX200355"], "status": "linear rule of thumb; Compressor OS default is adiabatic (C-1). Keep only as evidence for the explicit linear-override option."},
    {"claim": "About 94 % of compressor input energy becomes recoverable heat", "sources": ["SRC-D3775", "SRC-DX90160", "SRC-DX200355"]},
    {"claim": "Up to 98 % heat recovery, hot water up to 85 degC (Ultima closed-loop package)", "sources": ["SRC-ULTIMA"]},
    {"claim": "Regulated-speed saves up to 35 % versus fixed speed; energy is about 80 % of 5-year total cost", "sources": ["SRC-D3775", "SRC-DX90160", "SRC-DX200355", "SRC-DH"]},
    {"claim": "Compressed air systems account for about 10 % of industrial electricity", "sources": ["SRC-DX90160", "SRC-DX200355"]},
    {"claim": "Traditional two-stage oil-free: 6000-25000 rpm, discharge up to 200 degC, 5-7 gears, >15 bearings; DH water-injected: <=3500 rpm, ~60 degC, 0 gears, 7 bearings", "sources": ["SRC-DH"]},
    {"claim": "SmartAir Master sequencer harmonises up to 12 compressors; base-load module controls up to 4", "sources": ["SRC-D3775", "SRC-DX90160", "SRC-DX200355"]}
  ],
